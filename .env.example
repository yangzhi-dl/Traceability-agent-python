# ===== 复制本文件为 .env 并填入真实值 =====
# .env 已被 .gitignore 忽略，永远不会提交到仓库。

# --- 运行模式：auto / mock / llm ---
# auto = 有 OPENAI_API_KEY 走 LLM，否则降级 mock
# mock = 纯本地确定性逻辑，不调 LLM
# llm  = 强制 LLM，缺 Key 直接报错
AGENT_MODE=mock

# --- LLM 接入（OpenAI 兼容接口，千问/DeepSeek 等均可用）---
# 千问示例：https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=qwen-plus

# --- 评测裁判模型（可选，默认复用 OPENAI_MODEL 或 gpt-4o-mini）---
JUDGE_MODEL=

# --- 网关认证令牌（生产环境必填；留空 = 显式 localhost 演示模式）---
GATEWAY_TOKEN=

# --- 生产环境标识：demo 之外必须配 GATEWAY_TOKEN ---
APP_ENV=demo

# --- Redis 检查点（可选；不配则用进程内存检查点）---
REDIS_URL=

# --- RAG 检索后端：mock / real ---
RAG_BACKEND=mock

# --- Tavily 联网搜索（可选；不配则搜索降级为 NOT_CONFIGURED）---
TAVILY_API_KEY=
